# OOM — full live-LLM round (Chinese), par-bot pilot, same seed as the EN
# recording: identical sim, identical waves, different story language —
# the LLM is texture, never truth.
Output "/tmp/oom-llm-zh.mp4"
Set FontSize 13
Set Width 1100
Set Height 560
Set Padding 10

Type "/Users/ran/.bun/bin/bun src/cli.ts play --llm --llm-lang zh --pilot par --seed 7"
Enter
Sleep 193s
Type "q"
Sleep 1s
Type "q"
Sleep 1.5s
