# OOM — Stage 0 demo reel (~12 s): streaming reflow + fold/unfold tween.
# Render from the repo root: vhs assets/demo.tape
Output "/tmp/oom-demo.gif"
Set FontSize 13
Set Width 1100
Set Height 560
Set Padding 10
Set TypingSpeed 30ms

Type "/Users/ran/.bun/bin/bun src/cli.ts demo assets/demo.md"
Enter
Sleep 7s
Type "e"
Sleep 1.5s
Type "e"
Sleep 1.5s
Type "e"
Sleep 1s
Type "q"
Sleep 500ms
